# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI="mongodb://127.0.0.1:27017/keshabbhatt_portfolio"

# JWT Authentication Secret Key
JWT_SECRET="your-secure-random-jwt-secret-key-32-characters"

# Super Admin Initial Credentials (Auto-seeded on first connection if no admin exists)
SUPERADMIN_NAME="Your Name"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="change_this_to_a_secure_password"

# Public URL of the web application (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
