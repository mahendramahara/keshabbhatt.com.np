# ==============================================================================
# Environment Variables Example for Keshab Bhatt Portfolio Monorepo
# Copy this file to apps/portfolio-web/.env (or .env.local) and fill in credentials
# ==============================================================================

# Supabase API Configuration (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Connection (Supabase Project Settings -> Database)
# Transaction Pooler (port 6543) - used by Prisma in serverless / production
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# Direct Connection (port 5432) - used by Prisma for migrations and CLI
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Public URL of the web application (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional Cron secret for securing keep-alive API endpoints
CRON_SECRET=
