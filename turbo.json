{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "MONGODB_URI",
    "JWT_SECRET",
    "SUPERADMIN_NAME",
    "SUPERADMIN_EMAIL",
    "SUPERADMIN_USERNAME",
    "SUPERADMIN_PASSWORD",
    "NEXT_PUBLIC_SITE_URL"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
