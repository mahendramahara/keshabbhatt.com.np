# Backend API URL (Next.js server)
# Optional in development: if left empty, the mobile app automatically auto-detects
# your computer's IP address from Expo Metro (e.g. http://192.168.1.65:3000)
EXPO_PUBLIC_API_URL=http://192.168.1.65:3000

# Public website URL for "Open Live Web Portfolio" actions
EXPO_PUBLIC_WEB_URL=http://192.168.1.65:3000

# Domain text displayed on splash screen
EXPO_PUBLIC_BRAND_DOMAIN=keshabbhatt.com.np

# Disable strict react-navigation check in Expo Router SDK 56+
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
