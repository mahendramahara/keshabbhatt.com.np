# Backend API URL (Next.js server)
# Production: https://keshabbhatt.com.np
# Local development: e.g. http://192.168.1.65:3000 or leave empty for auto-detect
EXPO_PUBLIC_API_URL=https://keshabbhatt.com.np

# Public website URL for "Open Live Web Portfolio" actions
EXPO_PUBLIC_WEB_URL=https://keshabbhatt.com.np

# Domain text displayed on splash screen & header
EXPO_PUBLIC_BRAND_DOMAIN=keshabbhatt.com.np

# Disable strict react-navigation check in Expo Router SDK 56+
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1
