{
  "expo": {
    "name": "Keshab Bhatt Portfolio",
    "slug": "keshab-bhatt-portfolio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "keshabbhatt",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#040e24",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "np.com.keshabbhatt.portfolio",
      "buildNumber": "1"
    },
    "android": {
      "package": "np.com.keshabbhatt.portfolio",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#061739"
      },
      "permissions": [
        "INTERNET"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#040e24",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92484b09-b8de-41a1-85aa-9c9e282db196"
      }
    }
  }
}
