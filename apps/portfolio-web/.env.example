# MongoDB & Mongoose Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/keshabbhatt_portfolio

# Authentication & Session Security
JWT_SECRET=your-random-jwt-secret-key-at-least-32-chars

# Super Administrator Auto-Seed
# Auto-created on initial database connection if no admin exists
SUPERADMIN_NAME="Your Name"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="change_this_to_a_secure_password"

# Application URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
